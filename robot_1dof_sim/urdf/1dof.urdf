<?xml version="1.0" ?>
<robot name="arm_2dof_cylindrical" xmlns:xacro="http://ros.org/wiki/xacro">

<xacro:arg name="yaml_file_path" default=""/>

<material name="Red"><color rgba="0.8 0.1 0.1 1.0"/></material>
<material name="Green"><color rgba="0.2 0.7 0.2 1.0"/></material>
<material name="Blue"><color rgba="0.2 0.3 0.8 1.0"/></material>
<material name="Yellow"><color rgba="0.9 0.7 0.1 1.0"/></material>

<link name="world"/>

<joint name="fixed_to_world" type="fixed">
<parent link="world"/>
<child link="base_link"/>
<origin xyz="0 0 0" rpy="0 0 0"/>
</joint>

<link name="base_link">
<visual>
<origin xyz="0 0 0.05"/>
<geometry>
<cylinder radius="0.15" length="0.1"/>
</geometry>
<material name="Red"/>
</visual>

<collision>
<origin xyz="0 0 0.05"/>
<geometry>
<cylinder radius="0.15" length="0.1"/>
</geometry>
</collision>

<inertial>
<origin xyz="0 0 0.05"/>
<mass value="5.0"/>
<inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
</inertial>
</link>

<joint name="joint1" type="revolute">
<parent link="base_link"/>
<child link="link1"/>
<origin xyz="0 0 0.15"/>
<axis xyz="0 -1 0"/>
<limit lower="-3.14159" upper="3.14159" effort="1000" velocity="10"/>
<dynamics damping="0.1"/>
</joint>

<link name="link1">

<visual>
<origin xyz="0 0 0" rpy="1.5708 0 0"/>
<geometry>
<cylinder radius="0.06" length="0.12"/>
</geometry>
<material name="Blue"/>
</visual>

<visual>
<origin xyz="0.25 0 0" rpy="0 1.5708 0"/>
<geometry>
<cylinder radius="0.04" length="0.5"/>
</geometry>
<material name="Green"/>
</visual>

<collision>
<origin xyz="0.25 0 0" rpy="0 1.5708 0"/>
<geometry>
<cylinder radius="0.04" length="0.5"/>
</geometry>
</collision>

<inertial>
<origin xyz="0.25 0 0"/>
<mass value="1.2"/>
<inertia ixx="0.005" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
</inertial>

</link>

<joint name="joint2" type="revolute">
<parent link="link1"/>
<child link="link2"/>
<origin xyz="0.5 0 0"/>
<axis xyz="0 -1 0"/>
<limit lower="-3.14159" upper="3.14159" effort="1000" velocity="10"/>
<dynamics damping="0.1"/>
</joint>

<link name="link2">

<visual>
<origin xyz="0 0 0" rpy="1.5708 0 0"/>
<geometry>
<cylinder radius="0.06" length="0.12"/>
</geometry>
<material name="Blue"/>
</visual>

<visual>
<origin xyz="0.2 0 0" rpy="0 1.5708 0"/>
<geometry>
<cylinder radius="0.04" length="0.4"/>
</geometry>
<material name="Green"/>
</visual>

<collision>
<origin xyz="0.2 0 0" rpy="0 1.5708 0"/>
<geometry>
<cylinder radius="0.04" length="0.4"/>
</geometry>
</collision>

<inertial>
<origin xyz="0.2 0 0"/>
<mass value="1.0"/>
<inertia ixx="0.005" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.04"/>
</inertial>

</link>

<joint name="joint_end_effector" type="fixed">
<parent link="link2"/>
<child link="end_effector"/>
<origin xyz="0.4 0 0"/>
</joint>

<link name="end_effector">
<visual>
<origin xyz="0.025 0 0"/>
<geometry>
<box size="0.05 0.1 0.16"/>
</geometry>
<material name="Yellow"/>
</visual>
</link>

<!-- ROS2 CONTROL -->

<ros2_control name="GazeboSimSystem" type="system">

<hardware>
<plugin>gz_ros2_control/GazeboSimSystem</plugin>
</hardware>

<joint name="joint1">
<command_interface name="effort"/>
<state_interface name="position"/>
<state_interface name="velocity"/>
</joint>

<joint name="joint2">
<command_interface name="effort"/>
<state_interface name="position"/>
<state_interface name="velocity"/>
</joint>

</ros2_control>

<!-- GAZEBO PLUGINS -->

<gazebo>

<plugin filename="gz_ros2_control-system"
name="gz_ros2_control::GazeboSimROS2ControlPlugin">
<parameters>$(arg yaml_file_path)</parameters>
</plugin>

<plugin filename="gz-sim-sensors-system"
name="gz::sim::systems::Sensors">
<render_engine>ogre2</render_engine>
</plugin>

<plugin filename="gz-sim-imu-system"
name="gz::sim::systems::Imu"/>

</gazebo>

<!-- IMU LINK1 -->

<gazebo reference="link1">

<sensor name="imu_link1" type="imu">

<always_on>true</always_on>
<update_rate>100</update_rate>
<topic>/link1/imu</topic>
<gz_frame_id>link1</gz_frame_id>

<imu>

<angular_velocity>

<x>
<noise type="gaussian">
<mean>0.002</mean>
<stddev>0.002</stddev>
</noise>
</x>

<y>
<noise type="gaussian">
<mean>0.002</mean>
<stddev>0.002</stddev>
</noise>
</y>

<z>
<noise type="gaussian">
<mean>0.002</mean>
<stddev>0.002</stddev>
</noise>
</z>

</angular_velocity>

</imu>

</sensor>

</gazebo>

<!-- IMU LINK2 -->

<gazebo reference="link2">

<sensor name="imu_link2" type="imu">

<always_on>true</always_on>
<update_rate>100</update_rate>
<topic>/link2/imu</topic>
<gz_frame_id>link2</gz_frame_id>

<imu>

<angular_velocity>

<x>
<noise type="gaussian">
<mean>0.002</mean>
<stddev>0.002</stddev>
</noise>
</x>

<y>
<noise type="gaussian">
<mean>0.001</mean>
<stddev>0.001</stddev>
</noise>
</y>

<z>
<noise type="gaussian">
<mean>0.001</mean>
<stddev>0.001</stddev>
</noise>
</z>

</angular_velocity>

</imu>

</sensor>

</gazebo>

</robot>
